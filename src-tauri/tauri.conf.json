{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Raser",
  "version": "1.0.0",
  "identifier": "io.github.darkness38.raser",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [
      {
        "title": "Raser",
        "width": 1280,
        "height": 820,
        "minWidth": 400,
        "minHeight": 550,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "transparent": false,
        "additionalBrowserArgs": "--enable-features=HardwareMediaKeyHandling,MediaSessionService"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
